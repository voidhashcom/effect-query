{
  "name": "effect-query",
  "version": "1.1.0",
  "description": "Effect adapter for Tanstack Query",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/voidhashcom/effect-query.git",
    "directory": "packages/effect-query"
  },
  "license": "MIT",
  "author": "Dominik Vít <dominik@voidhash.com>",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "package.json",
    "!**/*.test.*",
    "!**/__tests__"
  ],
  "scripts": {
    "build": "tsdown",
    "lint": "biome check .",
    "test": "vitest --typecheck",
    "typecheck": "tsc --noEmit --pretty"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@tanstack/react-query": "5.104.0",
    "@types/react": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/browser-playwright": "^5.0.3",
    "@vitest/browser-preview": "^5.0.3",
    "effect": "4.0.0",
    "playwright": "^1.63.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsdown": "0.23.0",
    "ultracite": "^7.12.2",
    "vitest": "^5.0.3",
    "vitest-browser-react": "^2.3.0"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.104.0",
    "effect": "^4.0.0",
    "react": ">=18.2.0"
  }
}
