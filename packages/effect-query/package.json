{
  "name": "effect-query",
  "version": "0.2.1-beta.3",
  "description": "Effect adapter for Tanstack Query",
  "repository": {
    "type": "git",
    "url": "https://github.com/voidhashcom/effect-query.git"
  },
  "scripts": {
    "build": "tsdown",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit --pretty",
    "test": "vitest --typecheck"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "package.json",
    "!**/*.test.*",
    "!**/__tests__"
  ],
  "author": "Dominik Vít <dominik@voidhash.com>",
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "^2.2.6",
    "@tanstack/react-query": "^5.90.5",
    "@types/react": "^19.1.0",
    "@vitejs/plugin-react": "^5.1.0",
    "@vitest/browser-playwright": "^4.0.6",
    "@vitest/browser-preview": "^4.0.6",
    "effect": "^3.18.4",
    "playwright": "^1.56.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tsdown": "^0.15.9",
    "ultracite": "^5.6.4",
    "vitest": "^4.0.1",
    "vitest-browser-react": "^2.0.2"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.90.5",
    "effect": "^3.18.4",
    "react": ">=18.2.0"
  }
}
